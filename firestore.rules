rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function church(churchId) { return get(/databases/$(database)/documents/churches/$(churchId)).data; }
    function isMember(churchId) { return signedIn() && request.auth.uid in church(churchId).members; }
    function isAdmin(churchId) { return signedIn() && church(churchId).members[request.auth.uid] == 'admin'; }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function myEmail() { return request.auth.token.get('email', '').lower(); }

    // Is this minister the signed-in person? The same test as findPersonForUser in model.js.
    function isMe(person) {
      return person.get('userId', '') == request.auth.uid
        || (myEmail() != '' && (person.get('email', '') == myEmail() || person.get('contact', '').trim().lower() == myEmail()));
    }
    function preacherIsMe(churchId, ids, i) {
      return ids.size() > i && isMe(get(/databases/$(database)/documents/churches/$(churchId)/people/$(ids[i])).data);
    }
    // The save names a minister and role; both are checked here. The same test as songRole in model.js.
    function canEditSongs(churchId, personId, roleId) {
      let person = get(/databases/$(database)/documents/churches/$(churchId)/people/$(personId)).data;
      let role = get(/databases/$(database)/documents/churches/$(churchId)/roles/$(roleId)).data;
      return isMe(person)
        && roleId in person.get('roleIds', [])
        && role.name.lower().matches('(worship lead|tech).*');
    }
    function validSermon(s) {
      return s.keys().hasOnly(['title', 'scripture', 'seriesId'])
        && s.title is string && s.title.size() <= 120
        && s.scripture is string && s.scripture.size() <= 120
        && s.seriesId is string && s.seriesId.size() <= 80;
    }

    // Which church you belong to. Only you can read or change it.
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /churches/{churchId} {
      allow read: if isMember(churchId);
      // You can only create a church with yourself as its admin.
      allow create: if signedIn()
        && request.resource.data.members.keys().hasOnly([request.auth.uid])
        && request.resource.data.members[request.auth.uid] == 'admin';
      // Only an admin changes the settings or who is a member.
      allow update: if isAdmin(churchId)
        // Leaving: a member may take themselves (and only themselves) off the list.
        || (isMember(churchId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberNames', 'memberPhotos'])
          && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.memberNames.diff(resource.data.memberNames).affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.get('memberPhotos', {}).diff(resource.data.get('memberPhotos', {})).affectedKeys().hasOnly([request.auth.uid])
          && !(request.auth.uid in request.resource.data.members))
        // Your profile: a member may change their own name and photo, and nobody else's.
        || (isMember(churchId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberNames', 'memberPhotos'])
          && request.resource.data.memberNames.diff(resource.data.memberNames).affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.get('memberPhotos', {}).diff(resource.data.get('memberPhotos', {})).affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.memberNames[request.auth.uid] is string
          && request.resource.data.get('memberPhotos', {}).get(request.auth.uid, '') is string
          && request.resource.data.memberNames[request.auth.uid].size() > 0
          && request.resource.data.memberNames[request.auth.uid].size() <= 60
          && request.resource.data.get('memberPhotos', {}).get(request.auth.uid, '').size() <= 40000)
        // Joining by invite link: you may add yourself (and only yourself) as an editor,
        // unless an admin removed you.
        || (signedIn()
          && !(request.auth.uid in resource.data.members)
          && !(request.auth.uid in resource.data.get('removed', {}))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberNames'])
          && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.members[request.auth.uid] == 'editor'
          && request.resource.data.memberNames.diff(resource.data.memberNames).affectedKeys().hasOnly([request.auth.uid]));
      allow delete: if isAdmin(churchId);

      match /{collection}/{docId} {
        allow read: if collection in ['roles', 'people', 'series', 'services', 'tasks'] && isMember(churchId);
        // Only an admin changes the schedule, ministers, series, roles or tasks. The two blocks
        // below are the only exceptions: songs, a preacher's sermon, and your own minister.
        allow write: if collection in ['roles', 'people', 'series', 'services', 'tasks'] && isAdmin(churchId);
      }

      match /services/{serviceId} {
        // Worship Leaders and Tech may change the songs on a service, and nothing else on it.
        allow update: if isMember(churchId)
          && changed().hasOnly(['setlist', 'setlistBy', 'setlistRole'])
          && request.resource.data.setlist is list
          && request.resource.data.setlist.size() <= 30
          && canEditSongs(churchId, request.resource.data.setlistBy, request.resource.data.setlistRole);
        // A preacher may edit the sermon on a service they are assigned to preach, and nothing else on it.
        allow update: if isMember(churchId)
          && changed().hasOnly(['sermon'])
          && validSermon(request.resource.data.sermon)
          && (preacherIsMe(churchId, resource.data.assignments.get('preacher', []), 0)
            || preacherIsMe(churchId, resource.data.assignments.get('preacher', []), 1)
            || preacherIsMe(churchId, resource.data.assignments.get('preacher', []), 2));
      }

      match /people/{personId} {
        // Your own minister: your name and photo.
        allow update: if isMember(churchId)
          && isMe(resource.data)
          && changed().hasOnly(['name', 'photo'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 60
          && request.resource.data.get('photo', '') is string
          && request.resource.data.get('photo', '').size() <= 40000;
        // Link yourself to a minister nobody else has claimed (a personal invite, or your email
        // on file), or add your email to your own minister, unless it has someone else's email.
        allow update: if isMember(churchId)
          && resource.data.get('userId', '') in ['', request.auth.uid]
          && resource.data.get('email', '') in ['', myEmail()]
          && changed().hasOnly(['userId', 'email'])
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.get('email', '') == myEmail();
      }
    }
  }
}
